<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone design experiment. No activity or Compose screen loads this layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/design_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141318"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:text="HyperLock Extended"
        android:textColor="#F4EEF8"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live preview"
                android:textColor="#D2C1E9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/battery_preview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#292731"
                android:gravity="center"
                android:text="♥  33%"
                android:textColor="#D2BEE9"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/battery_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Battery"
                android:textColor="#F4EEF8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/battery_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Battery style" />

            <Button
                android:id="@+id/battery_components"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Components" />

            <Button
                android:id="@+id/battery_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Colors and brightness" />

            <Button
                android:id="@+id/battery_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charging animation" />

            <TextView
                android:id="@+id/control_center_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Control Center"
                android:textColor="#F4EEF8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/control_center_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Images and cropping" />

            <Button
                android:id="@+id/control_center_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Icon and text colors" />

            <Button
                android:id="@+id/control_center_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card layout" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#242229"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home" />

        <Button
            android:id="@+id/nav_components"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Components" />

        <Button
            android:id="@+id/nav_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="About" />
    </LinearLayout>
</LinearLayout>
