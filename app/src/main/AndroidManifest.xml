<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the settings app talks to the network, to ask GitHub for the newest
         release. The hooked SystemUI process never gets this permission because
         it is granted per-package, and the hooks make no network calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <permission android:name="${applicationId}.permission.PREVIEW_BATTERY_WARNING" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.PREVIEW_BATTERY_WARNING" />

    <!-- Declaring this is what lets PackageManager.canRequestPackageInstalls()
         ever answer true; without it the check is false forever and the updater
         cannot even hand the downloaded APK to the system installer. It grants no
         ability to install silently: the user still confirms in the system dialog,
         and on MIUI they must first flip "install unknown apps" for this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- miuix-blur declares android:minSdkVersion="33" because its effects need
         RuntimeShader. We keep 29: every effect in the library is gated on
         isRuntimeShaderSupported() at runtime and silently falls back to plain
         drawing below API 33, so the older floor costs only the blur itself. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- Allow the provider to verify the Xiaomi launcher UID for its own gesture image. -->
    <queries><package android:name="com.miui.home" /></queries>

    <application
        android:name="io.github.yixing233.hyperduo.HyperDuoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="libxposed"
            android:value="true" />

        <!-- LSPosed / Vector manager entry point. -->
        <activity
            android:name="io.github.yixing233.hyperduo.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- Launcher entry point so the settings app can also be opened directly. -->
        <activity-alias
            android:name="${applicationId}.ui.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity="io.github.yixing233.hyperduo.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Fixed images are limited to SystemUI, this app, and the launcher gesture image. -->
        <provider android:name="io.github.yixing233.hyperduo.ControlCenterImageProvider"
            android:authorities="${applicationId}.controlcenterimages"
            android:exported="true" android:grantUriPermissions="false" />

        <!-- Serves the downloaded APK to the system installer. The installer is a
             different process, so a plain file:// path would be refused on every
             supported Android version. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
